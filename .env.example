# FinCredit Copilot -- local environment configuration
# Copy to .env and adjust values for your local setup.

# -- Company display name --
# Used in UI header/footer, agent prompts, and API title.
APP_NAME=fincredit-copilot
COMPANY_NAME=融安住房金融（虚构演示机构）
AGENT_NAME=小融

# -- Database (Postgres container) --
POSTGRES_DB=mortgage-ai
POSTGRES_USER=user
POSTGRES_PASSWORD=password

# -- Database (application connection) --
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5433/mortgage-ai

COMPLIANCE_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5433/mortgage-ai

# -- API --
DEBUG=false
ALLOWED_HOSTS=["http://localhost:3000"]

# -- Document storage (local MinIO defaults) --
S3_ENDPOINT=http://localhost:9090
S3_ACCESS_KEY=minio
S3_SECRET_KEY=miniosecret
S3_BUCKET=documents
S3_REGION=us-east-1
S3_UPLOAD_CHECKSUM=sha256
S3_AUTO_CREATE_BUCKET=true
# Cloudflare R2 Standard: create a private Standard bucket first, then set
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_UPLOAD_CHECKSUM=md5
# S3_AUTO_CREATE_BUCKET=false
# Use bucket-scoped R2 Object Read & Write credentials via the secret store.
# On Render, leave S3_HOSTPORT empty so it cannot override S3_ENDPOINT.

# -- Auth / Keycloak --
# Set to true to bypass JWT validation (local dev without Keycloak)
AUTH_DISABLED=true
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=mortgage-ai

# -- Safety / NeMo Guardrails --
# Set NEMO_GUARDRAILS_ENDPOINT to enable NeMo Guardrails input/output filtering.
# Point to an independently operated compatible safety service.
# When not set, shields are disabled (agents work normally without filtering).
#NEMO_GUARDRAILS_ENDPOINT=http://localhost:18000

# -- Alibaba Cloud Model Studio / Qwen --
# Keep the real key only in .env. Never commit or paste it into documentation.
DASHSCOPE_API_KEY=
# The legacy DashScope-compatible endpoint is suitable for this local demo.
# A workspace-specific Beijing endpoint can be supplied here later.
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.7-plus
CHAT_RESPONSE_TIMEOUT_SECONDS=120
CHAT_AGENT_RECURSION_LIMIT=12
LLM_API_KEY=

# Dedicated Qwen-VL chain for scanned pages.
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_MODEL=qwen3.6-flash
VISION_API_KEY=

# Dedicated multilingual embedding chain. The database column is Vector(768).
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=768

# Fields below this score enter human review.
EXTRACTION_CONFIDENCE_THRESHOLD=0.8
INCOME_MISMATCH_THRESHOLD=0.15

# -- MLFlow (Observability) --
# MLFlow tracking server URI. When set, tracing is active.
# Leave blank to disable tracing.
# MLFLOW_TRACKING_URI=http://localhost:5000
# MLFlow experiment name for grouping traces.
# MLFLOW_EXPERIMENT_NAME=fincredit-copilot

# MCP Risk Assessment Server (used by underwriter agent for risk tool calls)
MCP_RISK_SERVER_URL=http://mcp-risk-server:8081/mcp

# Predictive model MCP server (optional, leave empty to disable)
# When set, the underwriter risk assessment includes an ML-based loan approval prediction.
PREDICTIVE_MODEL_MCP_URL=

# -- UI --
VITE_API_BASE_URL=http://localhost:8000
VITE_ENVIRONMENT=development
