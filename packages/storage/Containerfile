# MinIO community source release, built without the retired minio/minio images.
# Upstream: https://github.com/minio/minio/releases/tag/RELEASE.2025-10-15T17-29-55Z
FROM golang:1.26.9-alpine3.24@sha256:cdfd4fe2da6b225d8b40c6b7a105736e548e83ff56d5d8f9394446eeb5eb84e0 AS builder

ARG MINIO_COMMIT=9e49d5e7a648f00e26f2246f4dc28e6b07f8c84a
ARG MINIO_SOURCE_SHA256=45521908307306e925c98d629e1c17d78c8b72b6ee242b1bfb1409f7d8ee5841

# Bound concurrent compilation and Go heap growth on shared build workers.
ENV CGO_ENABLED=0 \
    GOTOOLCHAIN=local \
    GOMAXPROCS=2 \
    GOMEMLIMIT=512MiB

RUN apk add --no-cache ca-certificates curl
WORKDIR /src/minio
RUN curl --fail --show-error --silent --location --retry 3 \
        "https://codeload.github.com/minio/minio/tar.gz/${MINIO_COMMIT}" \
        --output /tmp/minio-source.tar.gz \
    && printf '%s  %s\n' "${MINIO_SOURCE_SHA256}" /tmp/minio-source.tar.gz | sha256sum -c - \
    && tar -xzf /tmp/minio-source.tar.gz --strip-components=1 -C /src/minio \
    && rm /tmp/minio-source.tar.gz

RUN go mod download && go mod verify
RUN mkdir -p /out \
    && go build -p 1 -tags kqueue -trimpath \
        -ldflags "-s -w -X github.com/minio/minio/cmd.Version=2025-10-15T17:29:55Z -X github.com/minio/minio/cmd.ReleaseTag=RELEASE.2025-10-15T17-29-55Z -X github.com/minio/minio/cmd.CommitID=${MINIO_COMMIT} -X github.com/minio/minio/cmd.ShortCommitID=9e49d5e7a648 -X github.com/minio/minio/cmd.CopyrightYear=2025" \
        -o /out/minio . \
    && /out/minio --version

FROM alpine:3.24@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6 AS runtime

LABEL org.opencontainers.image.source="https://github.com/minio/minio" \
      org.opencontainers.image.revision="9e49d5e7a648f00e26f2246f4dc28e6b07f8c84a" \
      org.opencontainers.image.version="RELEASE.2025-10-15T17-29-55Z" \
      org.opencontainers.image.licenses="AGPL-3.0-or-later"

RUN apk add --no-cache ca-certificates \
    && addgroup -S -g 10001 minio \
    && adduser -S -D -H -u 10001 -G minio minio \
    && mkdir -p /home/minio /tmp/fincredit-data /usr/share/licenses/minio \
    && chown minio:minio /home/minio /tmp/fincredit-data

COPY --from=builder /out/minio /usr/local/bin/minio
COPY --from=builder /src/minio/LICENSE /usr/share/licenses/minio/LICENSE

ENV HOME=/home/minio \
    GOMAXPROCS=2 \
    GOMEMLIMIT=384MiB
USER 10001:10001
WORKDIR /home/minio
RUN minio --version

EXPOSE 10000
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD wget -q -T 5 -O /dev/null http://127.0.0.1:10000/minio/health/live || exit 1
CMD ["minio", "server", "/tmp/fincredit-data", "--address", ":10000"]
